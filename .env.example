DG_DISABLE_LIVE=false
DG_DATA_FRESHNESS_MS=15000
MT_DATA_FRESHNESS_MS=15000
ELECTRONIC_PENDING_TIMEOUT_MS=90000
# LINE 會員入口模式：預設 true，一般會員只引導至網站，管理員指令仍保留。
LINE_WEBSITE_ONLY_MODE=false

# ATG AI 預測X輔助程式（與黑域AI LINE 完全獨立）
