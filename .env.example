ATG_SOCKET_ORIGIN=https://play.godeebxp.com
ATG_DISABLE_LIVE=false
ATG_RELAY_KEY=replace-with-a-long-random-secret

# DG baccarat relay (may reuse ATG_RELAY_KEY when omitted)
DG_RELAY_KEY=replace-with-a-long-random-secret
