{
  "manifest_version": 3,
  "name": "BLACKDOMAIN T9 Relay",
  "version": "1.0.1",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://g.t9gaming.fun/VideoBaccarat/index.html*"
      ],
      "js": [
        "capture.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://g.t9gaming.fun/VideoBaccarat/index.html*"
      ],
      "js": [
        "relay.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
