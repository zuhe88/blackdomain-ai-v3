{
  "manifest_version": 3,
  "name": "BLACKDOMAIN 3A Game Relay",
  "version": "1.3.8",
  "description": "Synchronizes approved 3A game data with BLACKDOMAIN AI.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://blackdomain-ai-v3-production.up.railway.app/*",
    "https://*.3a1788.bet/*",
    "https://*.3a178.club/*",
    "https://mbracing.cc/*",
    "https://play.godeebxp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.3a1788.bet/*",
        "https://*.3a178.club/*"
      ],
      "js": [
        "session-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mbracing.cc/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mbracing.cc/*"
      ],
      "js": [
        "session-guard.js",
        "relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://play.godeebxp.com/egames/*"
      ],
      "js": [
        "atg-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.godeebxp.com/egames/*"
      ],
      "js": [
        "atg-relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
