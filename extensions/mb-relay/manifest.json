{
  "manifest_version": 3,
  "name": "BLACKDOMAIN 3A Game Relay",
  "version": "1.1.8",
  "description": "Synchronizes approved 3A game data with BLACKDOMAIN AI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://blackdomain-ai-v3-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mbracing.cc/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mbracing.cc/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://play.godeebxp.com/egames/*"
      ],
      "js": [
        "atg-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.godeebxp.com/egames/*"
      ],
      "js": [
        "atg-relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gsa.ofalive99.net/*",
        "https://gsa.mtx55.net/*",
        "https://gsa.mtx66.net/*",
        "https://gsa.mtx77.net/*",
        "https://gsa.mtx88.net/*"
      ],
      "js": [
        "mt-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gsa.ofalive99.net/*",
        "https://gsa.mtx55.net/*",
        "https://gsa.mtx66.net/*",
        "https://gsa.mtx77.net/*",
        "https://gsa.mtx88.net/*"
      ],
      "js": [
        "mt-relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
